{
  "name": "plaspool-storefront",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @plaspool/storefront",
    "build": "npm run build -w @plaspool/storefront",
    "lint": "eslint .",
    "lint:app": "eslint apps",
    "lint:packages": "eslint packages",
    "typecheck": "node scripts/typecheck.mjs",
    "preview": "npm run preview -w @plaspool/storefront",
    "deploy": "npm run deploy -w @plaspool/storefront",
    "upload": "npm run upload -w @plaspool/storefront"
  },
  "devDependencies": {
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.3.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.123.0"
  }
}

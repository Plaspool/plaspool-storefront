# Copy to `.env` and fill in. Never commit populated values —
# `.env` is excluded from version control.

# ── WordPress (headless content source) ─────────────────────────────────────

# Full URL of the WordPress REST API root, no trailing slash.
WORDPRESS_URL=

# Hostname only, registered in next.config.ts as a permitted remote image
# source for the Next.js image optimiser.
WORDPRESS_HOSTNAME=

# Shared secret authenticating revalidation webhooks from the companion
# plugin in `plugin/`. Generate with:
#   openssl rand -base64 32
WORDPRESS_WEBHOOK_SECRET=

# ── Outbound mail (contact form) ────────────────────────────────────────────

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
